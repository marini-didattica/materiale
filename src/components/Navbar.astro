---
import MobileNav from '@/components/MobileNav.astro';
import { withBase } from '@/utils/base';

export interface NavLink {
  href: string;
  label: string;
}

export interface Props {
  siteName: string;
  /** Destination of the site name; defaults to the material site home. */
  homeHref?: string;
  links?: NavLink[];
}

const { siteName, homeHref = withBase('/'), links = [] } = Astro.props;
const currentPath = Astro.url.pathname;
// Main-site links are handled by a different Astro deployment. Bypass the
// client router for them so its runtime never mixes with this site's scripts.
const isExternalHref = (href: string) => href.startsWith('http');
const homeIsExternal = isExternalHref(homeHref);

function normalizePath(path: string): string {
  if (path === '/') return '/';
  return path.endsWith('/') ? path.slice(0, -1) : path;
}

function isCurrent(href: string): boolean {
  const path = href.startsWith('http') ? new URL(href).pathname : href;
  return normalizePath(currentPath) === normalizePath(path);
}
---

<header class="sticky top-0 z-[var(--z-sticky)] h-[var(--nav-height)] border-b border-border bg-[var(--color-surface)] backdrop-blur-[12px]">
  <nav aria-label="Main navigation" class="h-full">
    <div class="relative mx-auto flex h-full max-w-[72rem] items-center px-[var(--space-lg)]">
      <a
        href={homeHref}
        data-astro-reload={homeIsExternal || undefined}
        class="text-lg font-bold text-text no-underline"
      >
        {siteName}
      </a>

      {links.length > 0 && (
        <ul
          class="absolute inset-x-0 hidden justify-center gap-[var(--space-md)] list-none p-0 pointer-events-none md:flex"
          role="list"
        >
          {links.map((link) => (
            <li class="pointer-events-auto">
              <a
                href={link.href}
                data-astro-reload={isExternalHref(link.href) || undefined}
                class:list={[
                  'text-sm font-medium text-text-secondary no-underline px-3 py-1.5 rounded-[var(--radius-lg)] transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] hover:text-text hover:bg-bg-secondary hover:shadow-(--shadow-sm)',
                  {
                    'text-text bg-bg-secondary shadow-(--shadow-sm)': isCurrent(link.href),
                  },
                ]}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}

      <div class="ml-auto flex items-center gap-[var(--space-sm)]">
        <slot />
        {links.length > 0 && <MobileNav links={links} currentPath={currentPath} />}
      </div>
    </div>
  </nav>
</header>
