---
import type { BreadcrumbItem } from '@/types';

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Percorso" class="min-w-0">
  <ol
    class="flex list-none flex-nowrap items-center gap-1 overflow-x-auto whitespace-nowrap p-0 text-sm text-text-secondary"
  >
    {items.map((item, index) => (
      <li class="flex shrink-0 items-center gap-1">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page" class="truncate font-medium text-text">{item.label}</span>
        ) : (
          <a
            href={item.href}
            data-astro-reload={item.href.startsWith('http') || undefined}
            class="rounded-sm text-text-secondary no-underline hover:text-accent"
          >
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
