---
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout
  title="Accesso amministrazione"
  eyebrow="Amministrazione"
  description="Inserisci le credenziali del docente per aprire il materiale riservato."
  robots="noindex, nofollow"
>
  <Card class="mx-auto max-w-md">
    <h2 class="mb-2 text-xl font-bold">Accedi</h2>
    <p class="leading-relaxed text-text-secondary">
      Questa area contiene il materiale del docente e non è indicizzata.
    </p>

    <form
      id="admin-login-form"
      method="POST"
      action="/__admin/login"
      class="mt-6 flex flex-col gap-4"
    >
      <input type="hidden" name="next" id="admin-login-next" value="/admin/" />

      <div class="flex flex-col gap-1">
        <label for="admin-username" class="text-sm font-semibold">Utente</label>
        <input
          type="text"
          id="admin-username"
          name="username"
          required
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          class="w-full rounded-md border border-border bg-surface px-3 py-2.5 text-text transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="admin-password" class="text-sm font-semibold">Password</label>
        <input
          type="password"
          id="admin-password"
          name="password"
          required
          autocomplete="current-password"
          class="w-full rounded-md border border-border bg-surface px-3 py-2.5 text-text transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15"
        />
      </div>

      <p id="admin-login-error" class="hidden text-sm text-error" role="alert">
        Credenziali non valide. Riprova.
      </p>

      <Button type="submit" class="w-full">Accedi</Button>
    </form>
  </Card>
</PageLayout>

<script>
  // Runs on the initial load and after every ClientRouter navigation.
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('admin-login-form');
    const next = document.getElementById('admin-login-next');
    const error = document.getElementById('admin-login-error');
    const username = document.getElementById('admin-username');
    const params = new URLSearchParams(window.location.search);
    const target = params.get('next');

    if (form instanceof HTMLFormElement && next instanceof HTMLInputElement) {
      if (
        target &&
        target.startsWith('/') &&
        !target.startsWith('//') &&
        !target.includes('\\')
      ) {
        next.value = target;
      }

      if (error instanceof HTMLElement && params.get('error') === '1') {
        error.classList.remove('hidden');
      }

      if (username instanceof HTMLInputElement) {
        username.focus();
      }
    }
  });
</script>
