---
import Explorer from '@/components/Explorer.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getAdminDirectoryPages } from '@/lib/content-index';
import type { BreadcrumbItem } from '@/types';
import { withBase } from '@/utils/base';
import { buildZipName, toDownloadSegment } from '@/utils/downloads';
import { encodePath } from '@/utils/paths';

export async function getStaticPaths() {
  return getAdminDirectoryPages();
}

const { entries, dir, downloadTree } = Astro.props;
const segments = dir.split('/').filter(Boolean);

const rootLabels: Record<string, string> = {
  public: 'Materiale pubblico',
  private: 'Materiale privato',
};

const labels = segments.map((segment, index) =>
  index === 0 ? (rootLabels[segment] ?? segment) : segment,
);
const title = labels.length > 0 ? labels[labels.length - 1] : 'Amministrazione';
const description =
  segments.length === 0
    ? 'Tutti i file pubblici e privati, senza codici di accesso.'
    : `Contenuto della cartella ${title}.`;

const crumbs: BreadcrumbItem[] = [
  { label: 'Amministrazione', href: withBase('/admin/') },
  ...segments.map((segment, index) => {
    const relative = segments.slice(0, index + 1).join('/');
    return {
      label: labels[index],
      href: withBase(`/admin/${encodePath(relative)}/`),
    };
  }),
];

const parentPath = segments.slice(0, -1).join('/');
const parentHref =
  segments.length > 0
    ? withBase(`/admin/${parentPath ? `${encodePath(parentPath)}/` : ''}`)
    : null;

const zipBaseName = ['amministrazione', ...segments].map(toDownloadSegment).join('-');
const zipName = buildZipName(['amministrazione', ...segments]);
---

<PageLayout
  title={title}
  eyebrow="Amministrazione"
  description={description}
  robots="noindex, nofollow"
  stableHeader
>
  <Explorer
    entries={entries}
    crumbs={crumbs}
    parentHref={parentHref}
    downloadTree={downloadTree}
    zipBaseName={zipBaseName}
    zipName={zipName}
  />
</PageLayout>
