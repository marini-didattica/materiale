{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marini-didattica.github.io/schemas/correction.schema.json",
  "title": "Correction descriptor",
  "oneOf": [
    {
      "title": "Absent student",
      "type": "object",
      "additionalProperties": false,
      "required": ["absent"],
      "properties": {
        "absent": { "const": true }
      }
    },
    {
      "title": "Present student",
      "type": "object",
      "additionalProperties": false,
      "required": ["set", "exercises"],
      "properties": {
        "absent": { "const": false },
        "set": { "type": "string", "minLength": 1 },
        "import-answers": { "type": "boolean" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "exercises": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/answer" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer-file", "score"],
      "properties": {
        "answer-file": { "$ref": "#/$defs/answerFile" },
        "score": { "type": "number", "minimum": 0 },
        "import-answer": { "type": "boolean" },
        "import-answers": { "type": "boolean" },
        "comment": { "type": "string" }
      }
    },
    "answerFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)(?!.*\\\\)(.*)$"
    }
  }
}
